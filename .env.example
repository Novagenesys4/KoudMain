APP_NAME=KoudMain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Production : LOG_CHANNEL=json (une ligne JSON par événement sur la sortie d'erreur, lue par Render). Local : stack/single (storage/logs).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (PostgreSQL : docker compose up -d db) ---
# En production (Render + Supabase) : ces valeurs se saisissent UNIQUEMENT dans les
# « Environment Variables » de Render. Aucun secret réel dans ce fichier ni dans Git.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=koudmain_laravel
DB_USERNAME=koudmain
DB_PASSWORD=koudmain_dev
DB_SSLMODE=prefer
# Rapidité avec une base DISTANTE (Supabase) : garder la connexion ouverte d'une page à l'autre.
# Avec Supabase depuis Render, utilisez l'adresse du « Session pooler » (port 5432 du pooler), pas le transaction pooler.
# DB_PERSISTENT=true

# --- Sessions : 120 minutes d'inactivité (plan, phase 0, étape 5) ---
# « file » : les sessions vivent sur le disque du serveur, sans aller-retour vers la base (3 requêtes SQL de moins par page).
# « database » les range dans la table sessions : plus lent, à réserver à plusieurs serveurs qui doivent les partager.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production (HTTPS) : true
SESSION_SECURE_COOKIE=false

# --- Sécurité (règles 8, 13, 14) ---
# En PRODUCTION (variables de Render, jamais ce fichier) : APP_DEBUG=false, SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true, TRUST_PROXY=true.
# Redirection http -> https + HSTS : automatique en production dès que TRUST_PROXY=true (FORCE_HTTPS=false pour la couper, déconseillé).
# FORCE_HTTPS=
# CORS : aucun autre site n'a accès à l'application par défaut. Pour ouvrir une adresse précise à un site partenaire (jamais « * ») :
# CORS_ALLOWED_ORIGINS=https://partenaire.example
# CORS_PATHS=api/*
# Contrôle au démarrage du conteneur : strict (défaut, refuse une configuration dangereuse) | avertir (affiche sans bloquer).
# CONTROLE_PRODUCTION=strict

# --- Derrière le proxy de Render : true. En local : false. ---
# À true, l'adresse IP du visiteur est lue dans X-Forwarded-For (dernière entrée, non falsifiable).
TRUST_PROXY=false

# Hôtes d'images autorisés en plus du site (séparés par des virgules), ex. le stockage Supabase :
# https://xxxx.supabase.co
CSP_IMG_HOSTS=

# --- Photos (lot 2) -------------------------------------------------------------------------------
# local    : fichiers dans public/uploads (développement).
# supabase : Supabase Storage (production : le disque de Render est effacé à chaque déploiement).
MEDIA_DRIVER=local
# Projet Supabase > Settings > API : « Project URL » puis la clé « service_role ».
# La clé service_role est SECRÈTE : uniquement dans les Environment Variables de Render, jamais dans Git.
# Créez aussi un bucket public nommé « medias » (Storage > New bucket > Public bucket).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=medias
# Vérification d'identité (KYC) : bucket PRIVÉ, distinct des photos publiques. KYC_STOCKAGE=local|supabase (défaut : MEDIA_DRIVER).
SUPABASE_BUCKET_KYC=kyc-prive

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Le cache sert aux limites de tentatives, à la présence en ligne et aux listes qui changent peu : « file » évite la base.
CACHE_STORE=file

# --- E-mails (lot 4) : « log » écrit dans storage/logs en local ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@koudmain.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Temps réel et notifications (lot 4) ---
# TEMPS_REEL_ACTIF=true
# auto (défaut) = flux instantané si le serveur le supporte, sinon interrogation toutes les 3 s ; flux | sondage pour forcer.
# TEMPS_REEL_MODE=auto
# TEMPS_REEL_DUREE=25
# TEMPS_REEL_PAUSE_MS=800
# NOTIFICATIONS_EMAIL=true
# En production, un SMTP (exemple Brevo) : MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, MAIL_USERNAME=..., MAIL_PASSWORD=...

VITE_APP_NAME="${APP_NAME}"

# Page /composants (vitrine du kit d'interface, données fictives). Absente en production par défaut.
# KOUDMAIN_VITRINE=true

# Paiement Mobile Money : simulation (fictif, défaut hors production) | cinetpay | aucun (défaut en production)
PAIEMENT_DRIVER=simulation

# Codes de vérification de l'application mobile : journal (dev, code dans storage/logs), email (via MAIL_*), aucun.
SMS_DRIVER=journal
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=
# CINETPAY_VERIFIER_SIGNATURE=true

# --- Lot 5 : suivi, métriques, conteneur ---------------------------------------------------------
# Sentry (suivi des erreurs) : laissez vide pour désactiver. Sentry > Settings > Projects > Client Keys (DSN).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Version affichée dans Sentry et la page « Métriques et santé » (sur Render : les 7 premiers caractères du commit, automatiquement).
# APP_VERSION=koudmain@1.0.0
# Durée (secondes) pendant laquelle la page admin « Métriques » garde ses chiffres en cache.
# METRIQUES_CACHE=120
# Docker/Render (voir DEPLOIEMENT.md) : RUN_MIGRATIONS=0 saute la migration au démarrage, RUN_SCHEDULER=0 ne lance pas le planificateur,
# APACHE_MAX_WORKERS = nombre de processus Apache (= connexions ouvertes vers la base).
# RUN_MIGRATIONS=1
# RUN_SCHEDULER=1
# APACHE_MAX_WORKERS=8
