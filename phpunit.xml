<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Les migrations utilisent des fonctions propres à PostgreSQL (recherche plein texte, index partiel,
            contraintes CHECK) : les tests tournent donc sur PostgreSQL, PAS sur SQLite.
            force="true" : ces valeurs l'emportent sur toute variable d'environnement déjà définie sur la
            machine, pour qu'un test ne puisse jamais viser votre base de développement (RefreshDatabase la viderait).
            Base de test : voir docker-compose.yml et docker/postgres/01-base-de-test.sql.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="5433" force="true"/>
        <env name="DB_DATABASE" value="koudmain_test" force="true"/>
        <env name="DB_USERNAME" value="koudmain" force="true"/>
        <env name="DB_PASSWORD" value="koudmain_dev" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Les tests supposent les codes par SMS (journal) ; OtpEmailApiTest active lui-même le canal e-mail. Indépendant du .env local. -->
        <env name="SMS_DRIVER" value="journal" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TRUST_PROXY" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
