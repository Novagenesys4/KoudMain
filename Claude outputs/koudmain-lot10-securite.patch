@@ -0,0 +1,37 @@
+# Règle 18 : dépendances à jour. Dependabot ouvre chaque semaine une demande de fusion (pull request) pour les mises à jour,
+# et tout de suite pour les failles de sécurité. Les tests de .github/workflows/securite.yml valident chaque mise à jour.
+version: 2
+updates:
+  - package-ecosystem: composer
+    directory: /
+    schedule:
+      interval: weekly
+      day: monday
+    open-pull-requests-limit: 5
+    groups:
+      symfony:
+        patterns: ['symfony/*']
+      laravel:
+        patterns: ['laravel/*', 'illuminate/*']
+
+  - package-ecosystem: npm
+    directory: /
+    schedule:
+      interval: weekly
+      day: monday
+    open-pull-requests-limit: 5
+    groups:
+      react:
+        patterns: ['react', 'react-dom', '@vitejs/*']
+      vite-tailwind:
+        patterns: ['vite', 'laravel-vite-plugin', 'tailwindcss', '@tailwindcss/*']
+
+  - package-ecosystem: docker
+    directory: /
+    schedule:
+      interval: weekly
+
+  - package-ecosystem: github-actions
+    directory: /
+    schedule:
+      interval: monthly
diff --git a/.github/workflows/sauvegarde.yml b/.github/workflows/sauvegarde.yml
new file mode 100644
index 0000000..ab6d664
--- /dev/null
+++ b/.github/workflows/sauvegarde.yml
@@ -0,0 +1,140 @@
+# Règle 20 : sauvegarde automatique de la base de données, chiffrée, hors de Supabase et hors de Render.
+#
+#   Chaque nuit :  Supabase (session pooler) ──pg_dump──▶ vérifié (restauré dans une base jetable) ──chiffré (age)──▶ Cloudflare R2
+#
+# Pourquoi comme ça :
+#  - le fichier est CHIFFRÉ avant de quitter GitHub : il contient les données personnelles des utilisateurs. Seule la clé PRIVÉE age
+#    (gardée hors ligne, dans votre gestionnaire de mots de passe) peut le lire. Cloudflare, GitHub ou un voleur d'accès R2 n'obtiennent rien ;
+#  - la sauvegarde est RESTAURÉE chaque nuit dans une base PostgreSQL jetable : une sauvegarde jamais testée n'est pas une sauvegarde ;
+#  - Cloudflare R2 est un autre fournisseur que Supabase : une panne ou un compte suspendu chez l'un n'emporte pas l'autre ;
+#  - la durée de conservation (30 jours) se règle dans R2 (règle de cycle de vie), voir SECURITE.md.
+#
+# Réglages GitHub (Settings > Secrets and variables > Actions) : voir SECURITE.md, section « Sauvegardes ».
+name: Sauvegarde
+
+on:
+  schedule:
+    - cron: '30 2 * * *' # 02 h 30 UTC = 02 h 30 à Abidjan : le site est calme
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: sauvegarde
+  cancel-in-progress: false
+
+jobs:
+  base-de-donnees:
+    name: Sauvegarder la base
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    services:
+      postgres:
+        image: postgres:17
+        env:
+          POSTGRES_PASSWORD: verification-jetable
+        ports: ['5544:5432']
+        options: >-
+          --health-cmd "pg_isready -U postgres" --health-interval 5s --health-timeout 5s --health-retries 10
+    env:
+      # Version du client pg_dump : au moins celle de PostgreSQL chez Supabase (tableau de bord > Database > Infrastructure).
+      PG_CLIENT_VERSION: ${{ vars.BACKUP_PG_VERSION || '17' }}
+      DATABASE_URL: ${{ secrets.BACKUP_DATABASE_URL }}
+      AGE_RECIPIENT: ${{ vars.BACKUP_AGE_RECIPIENT }}
+      R2_ACCOUNT_ID: ${{ vars.R2_ACCOUNT_ID }}
+      R2_BUCKET: ${{ vars.R2_BUCKET }}
+      AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
+      AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
+      AWS_DEFAULT_REGION: auto
+      RENDER_API_KEY: ${{ secrets.RENDER_API_KEY }}
+      RENDER_SERVICE_ID: ${{ vars.RENDER_SERVICE_ID }}
+    steps:
+      - name: Vérifier les réglages
+        run: |
+          set -euo pipefail
+          manque=0
+          for v in DATABASE_URL AGE_RECIPIENT R2_ACCOUNT_ID R2_BUCKET AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; do
+            if [ -z "${!v}" ]; then echo "::error::Réglage manquant : $v (voir SECURITE.md, section Sauvegardes)"; manque=1; fi
+          done
+          case "$AGE_RECIPIENT" in age1*) ;; *) echo "::error::BACKUP_AGE_RECIPIENT doit être une clé PUBLIQUE age (age1...). Jamais la clé privée."; manque=1;; esac
+          exit $manque
+
+      - name: Installer pg_dump, age et le client PostgreSQL de la bonne version
+        run: |
+          set -euo pipefail
+          sudo install -d /usr/share/postgresql-common/pgdg
+          sudo curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail -sS https://www.postgresql.org/media/keys/ACCC4CF8.asc
+          echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" | sudo tee /etc/apt/sources.list.d/pgdg.list
+          sudo apt-get update -qq
+          sudo apt-get install -y -qq "postgresql-client-${PG_CLIENT_VERSION}" age
+          echo "/usr/lib/postgresql/${PG_CLIENT_VERSION}/bin" >> "$GITHUB_PATH"
+
+      - name: Exporter la base
+        run: |
+          set -euo pipefail
+          umask 077
+          horodatage="$(date -u +%Y-%m-%dT%H%MZ)"
+          echo "HORODATAGE=$horodatage" >> "$GITHUB_ENV"
+          # Schéma « public » = toutes les tables de KoudMain. Les sessions et le cache ne valent pas d'être gardés.
+          pg_dump "$DATABASE_URL" \
+            --format=custom --compress=9 --no-owner --no-privileges --schema=public \
+            --exclude-table-data='public.sessions' --exclude-table-data='public.cache' --exclude-table-data='public.cache_locks' \
+            --file="koudmain-$horodatage.dump"
+          ls -l "koudmain-$horodatage.dump"
+
+      - name: Vérifier que l'export est lisible et non vide
+        run: |
+          set -euo pipefail
+          f="koudmain-$HORODATAGE.dump"
+          taille=$(stat -c %s "$f")
+          if [ "$taille" -lt 10000 ]; then echo "::error::Export suspect ($taille octets)."; exit 1; fi
+          pg_restore --list "$f" > liste.txt
+          for table in users commandes wallets escrows; do
+            grep -Eq "TABLE DATA public $table( |$)" liste.txt || { echo "::error::La table $table est absente de l'export."; exit 1; }
+          done
+
+      - name: Restaurer dans une base jetable (preuve que la sauvegarde est utilisable)
+        run: |
+          set -euo pipefail
+          export PGPASSWORD=verification-jetable
+          psql -h 127.0.0.1 -p 5544 -U postgres -qc 'create extension if not exists unaccent' postgres
+          # Les erreurs sans gravité (rôles Supabase absents, etc.) n'arrêtent pas la restauration ; on contrôle le résultat ensuite.
+          pg_restore -h 127.0.0.1 -p 5544 -U postgres -d postgres --no-owner --no-privileges "koudmain-$HORODATAGE.dump" 2>restauration.log || true
+          tables=$(psql -h 127.0.0.1 -p 5544 -U postgres -Atc "select count(*) from information_schema.tables where table_schema='public' and table_type='BASE TABLE'" postgres)
+          lignes=$(psql -h 127.0.0.1 -p 5544 -U postgres -Atc "select count(*) from public.users" postgres)
+          echo "Base restaurée : $tables tables, $lignes utilisateurs."
+          [ "$tables" -ge 10 ] || { echo "::error::Restauration incomplète ($tables tables)."; tail -20 restauration.log; exit 1; }
+
+      - name: "Chiffrer (clé publique age : seule la clé privée hors ligne peut relire)"
+        run: |
+          set -euo pipefail
+          age -r "$AGE_RECIPIENT" -o "koudmain-$HORODATAGE.dump.age" "koudmain-$HORODATAGE.dump"
+          shred -u "koudmain-$HORODATAGE.dump" 2>/dev/null || rm -f "koudmain-$HORODATAGE.dump"
+          sha256sum "koudmain-$HORODATAGE.dump.age" | tee "koudmain-$HORODATAGE.dump.age.sha256"
+
+      - name: Envoyer vers Cloudflare R2 et vérifier
+        run: |
+          set -euo pipefail
+          fichier="koudmain-$HORODATAGE.dump.age"
+          destination="s3://$R2_BUCKET/base-de-donnees/$fichier"
+          point="https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com"
+          aws s3 cp "$fichier" "$destination" --endpoint-url "$point" --only-show-errors
+          aws s3 cp "$fichier.sha256" "$destination.sha256" --endpoint-url "$point" --only-show-errors
+          distant=$(aws s3api head-object --bucket "$R2_BUCKET" --key "base-de-donnees/$fichier" --endpoint-url "$point" --query ContentLength --output text)
+          local=$(stat -c %s "$fichier")
+          [ "$distant" = "$local" ] || { echo "::error::Taille distante ($distant) différente de la taille locale ($local)."; exit 1; }
+          echo "Sauvegarde envoyée : $destination ($local octets)."
+
+      - name: Sauvegarder aussi les variables d'environnement de Render (facultatif, chiffrées)
+        if: ${{ env.RENDER_API_KEY != '' && env.RENDER_SERVICE_ID != '' }}
+        run: |
+          set -euo pipefail
+          umask 077
+          curl -fsS -H "Authorization: Bearer $RENDER_API_KEY" -H "Accept: application/json" \
+            "https://api.render.com/v1/services/$RENDER_SERVICE_ID/env-vars?limit=100" -o secrets.json
+          age -r "$AGE_RECIPIENT" -o "koudmain-secrets-$HORODATAGE.json.age" secrets.json
+          shred -u secrets.json 2>/dev/null || rm -f secrets.json
+          aws s3 cp "koudmain-secrets-$HORODATAGE.json.age" "s3://$R2_BUCKET/secrets/koudmain-secrets-$HORODATAGE.json.age" \
+            --endpoint-url "https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com" --only-show-errors
+          echo "Variables d'environnement sauvegardées (chiffrées)."
diff --git a/.github/workflows/securite.yml b/.github/workflows/securite.yml
new file mode 100644
index 0000000..2875c8a
--- /dev/null
+++ b/.github/workflows/securite.yml
@@ -0,0 +1,114 @@
+# Sécurité continue (règles 2 et 18) : à chaque envoi de code, et chaque lundi (une faille est parfois publiée sans qu'on ait touché au code).
+#   1. gitleaks : aucun secret dans le code NI dans l'historique Git ;
+#   2. composer audit / npm audit : aucune dépendance avec une faille connue ;
+#   3. la suite de tests complète (555+ tests, sur une vraie base PostgreSQL) ;
+#   4. la construction des fichiers du navigateur (Vite) : aucun console.* ne doit y subsister.
+name: Sécurité
+
+on:
+  push:
+    branches: [main, master, laravel]
+  pull_request:
+  schedule:
+    - cron: '17 5 * * 1'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: securite-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  secrets:
+    name: Aucun secret dans le dépôt (gitleaks)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0 # tout l'historique : un secret supprimé plus tard reste lisible dans un ancien commit
+
+      - name: Installer gitleaks (version fixée, somme de contrôle vérifiée)
+        run: |
+          set -euo pipefail
+          v=8.24.2
+          curl -sSfL -O "https://github.com/gitleaks/gitleaks/releases/download/v${v}/gitleaks_${v}_linux_x64.tar.gz"
+          curl -sSfL -O "https://github.com/gitleaks/gitleaks/releases/download/v${v}/gitleaks_${v}_checksums.txt"
+          sha256sum -c gitleaks_${v}_checksums.txt --ignore-missing
+          tar -xzf "gitleaks_${v}_linux_x64.tar.gz" gitleaks
+
+      - name: Analyser l'historique complet
+        run: ./gitleaks git . --config .gitleaks.toml --redact --verbose --exit-code 1
+
+      - name: Aucun fichier .env versionné
+        run: |
+          if git ls-files | grep -E '(^|/)\.env($|\.)' | grep -v '^\.env\.example$'; then
+            echo "::error::Un fichier .env est suivi par Git. Retirez-le (git rm --cached) et changez les secrets qu'il contenait."
+            exit 1
+          fi
+
+  dependances:
+    name: Dépendances sans faille connue
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: shivammathur/setup-php@v2
+        with:
+          php-version: '8.4'
+          tools: composer:v2
+
+      - name: composer audit (paquets PHP, y compris outils de test)
+        run: composer audit --locked --format=plain
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+
+      - name: npm audit (paquets du navigateur livrés aux visiteurs)
+        run: npm audit --omit=dev --audit-level=high
+
+      - name: npm audit (outils de construction, information)
+        run: npm audit --audit-level=critical
+
+  tests:
+    name: Tests et construction
+    runs-on: ubuntu-latest
+    services:
+      postgres:
+        image: postgres:16
+        env:
+          POSTGRES_USER: koudmain
+          POSTGRES_PASSWORD: koudmain_dev # base éphémère du test (phpunit.xml impose ce mot de passe) : sans lien avec la production
+          POSTGRES_DB: koudmain_test
+        ports: ['5433:5432']
+        options: >-
+          --health-cmd "pg_isready -U koudmain" --health-interval 5s --health-timeout 5s --health-retries 10
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: shivammathur/setup-php@v2
+        with:
+          php-version: '8.4'
+          extensions: pdo_pgsql, gd, intl, zip
+          tools: composer:v2
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+          cache: npm
+
+      - run: composer install --no-interaction --no-progress --prefer-dist
+      - run: npm ci --no-audit --no-fund
+      - run: cp .env.example .env && php artisan key:generate --force
+      - run: npm run build
+
+      - name: Aucun console.* dans le JavaScript de production
+        run: |
+          if grep -rEl 'console\.(log|debug|info|trace)\(' public/build/assets/*.js; then
+            echo "::error::console.* trouvé dans le JavaScript construit (règle 15)."
+            exit 1
+          fi
+
+      - run: php artisan test
